<Window x:Class="UserLogin.Views.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UserLogin"
        mc:Ignorable="d"
        Title="AddUser" 
        Height="500"
        Width="800"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Přidání uživatele"
               FontSize="30"
               FontWeight="SemiBold"
               Margin="0 5 0 20" 
               HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" 
                Orientation="Horizontal"
                HorizontalAlignment="center"
                Margin="5">
            <Label Content="Name"
               Width="80" Padding="10"
               HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
            <Border Background="White"
                CornerRadius="12"
                Width="200" Padding="10">
                <TextBox x:Name="Name"
                 FontWeight="SemiBold"
                 BorderThickness="0"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="5">
            <Label Content="Password"
               Width="80" Padding="10"
               HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
            <Border Background="White"
                CornerRadius="12"
                Width="200" Padding="10">

                <PasswordBox x:Name="Password"
                         BorderThickness="0"/>
            </Border>
        </StackPanel>

        <Button Grid.Row="3"
            Content="➕ Přidat"
            Width="120" Margin="10"
            HorizontalAlignment="Center"
            Click="CreateUser" Cursor="Hand"/>

    </Grid>
</Window>